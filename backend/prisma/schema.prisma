// Half-Dinar Shops — database schema (source of truth: /CLAUDE.md section 5)
//
// Conventions:
//   - Primary keys are UUIDs generated by the database.
//   - Database tables/columns are snake_case (via @map/@@map); TypeScript stays camelCase.
//   - Money is Decimal(10,2) — never Float. Currency is JOD.
//   - Timestamps are timestamptz (UTC).
//   - Non-negative price constraints are enforced as CHECK constraints at the database level;
//     Prisma has no native CHECK syntax, so they live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // NestJS compiles to CommonJS, so the generated client must match.
  runtime      = "nodejs"
  moduleFormat = "cjs"
  // Emit extensionless relative imports. The generator's default (".js") is an
  // ESM convention that CommonJS resolution cannot map back onto the generated
  // .ts files, which breaks ts-node.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER @map("customer")
  MERCHANT @map("merchant")
  ADMIN    @map("admin")

  @@map("user_role")
}

enum MerchantStatus {
  PENDING   @map("pending")
  APPROVED  @map("approved")
  SUSPENDED @map("suspended")

  @@map("merchant_status")
}

enum OrderStatus {
  PENDING    @map("pending")
  CONFIRMED  @map("confirmed")
  PREPARING  @map("preparing")
  DELIVERING @map("delivering")
  DELIVERED  @map("delivered")
  CANCELLED  @map("cancelled")

  @@map("order_status")
}

enum CancelledBy {
  CUSTOMER @map("customer")
  MERCHANT @map("merchant")
  SYSTEM   @map("system")

  @@map("cancelled_by")
}

enum OrderItemStatus {
  CONFIRMED   @map("confirmed")
  UNAVAILABLE @map("unavailable")

  @@map("order_item_status")
}

enum DeliveryStatus {
  ASSIGNED  @map("assigned")
  PICKED_UP @map("picked_up")
  ON_WAY    @map("on_way")
  DELIVERED @map("delivered")
  FAILED    @map("failed")

  @@map("delivery_status")
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id          String   @id @default(uuid()) @db.Uuid
  // Stored E.164-normalized (+9627XXXXXXXX); format validated at the API layer.
  phoneNumber String   @unique @map("phone_number") @db.VarChar(20)
  otpVerified Boolean  @default(false) @map("otp_verified")
  role        UserRole @default(CUSTOMER)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  merchant     Merchant?
  orders       Order[]
  otpCodes     OtpCode[]
  deviceTokens DeviceToken[]

  @@map("users")
}

/// Push notification tokens, one row per device a customer signed in on.
///
/// Not part of the original spec's table list, for the same reason as `otp_codes`: the spec requires
/// a merchant cancellation to "trigger an immediate notification event to the customer", and there
/// is nowhere in the eight specified tables to record which device to notify. None of those tables
/// were altered.
///
/// One user can have several rows — a phone and a tablet, or the same phone after a reinstall
/// (Expo issues a new token). Tokens are deleted rather than accumulated when the push service
/// reports them dead, so a stale token is not retried forever.
model DeviceToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Expo push token, e.g. "ExponentPushToken[xxxxxxxx]".
  token String @unique @db.VarChar(255)

  /// "ios" | "android" — recorded for support; delivery does not depend on it.
  platform String? @db.VarChar(16)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Refreshed on every sign-in, so an abandoned device can be pruned later.
  lastSeenAt DateTime @default(now()) @updatedAt @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// One-time passcodes for phone login.
///
/// Not part of the original spec's table list, but the security checklist requires OTP secrets to
/// be hashed and never stored in plaintext — and the `users` table has nowhere to put them. Codes
/// are stored as argon2 hashes, expire quickly, and are single-use.
model OtpCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// argon2 hash of the 6-digit code. The plaintext code is never persisted.
  codeHash  String    @map("code_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Failed verification attempts, capped to blunt brute-force guessing.
  attempts  Int       @default(0)
  /// Set once the code is successfully used, making it single-use.
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_codes")
}

model Merchant {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  shopName       String         @map("shop_name") @db.VarChar(120)
  locationLat    Float          @map("location_lat")
  locationLng    Float          @map("location_lng")
  openingHours   String         @map("opening_hours") @db.VarChar(120)
  status         MerchantStatus @default(PENDING)
  // Fraction of order total taken as commission, e.g. 0.1500 = 15%.
  commissionRate Decimal        @default(0) @map("commission_rate") @db.Decimal(5, 4)

  // A merchant profile is meaningless without its user, so deleting the user removes it.
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]

  @@map("merchants")
}

model Category {
  id               String  @id @default(uuid()) @db.Uuid
  name             String  @db.VarChar(80)
  parentCategoryId String? @map("parent_category_id") @db.Uuid

  // Self-referencing tree. Deleting a parent is blocked while subcategories exist.
  parentCategory Category?  @relation("CategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subcategories  Category[] @relation("CategoryTree")
  products       Product[]

  @@unique([parentCategoryId, name])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  merchantId  String   @map("merchant_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(160)
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Restricted: order history must keep pointing at the product it was placed against.
  orderItems OrderItem[]

  @@index([merchantId])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id                 String       @id @default(uuid()) @db.Uuid
  customerId         String       @map("customer_id") @db.Uuid
  merchantId         String       @map("merchant_id") @db.Uuid
  status             OrderStatus  @default(PENDING)
  totalPrice         Decimal      @map("total_price") @db.Decimal(10, 2)
  deliveryFee        Decimal      @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  cancelledBy        CancelledBy? @map("cancelled_by")
  cancellationReason String?      @map("cancellation_reason") @db.VarChar(500)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  customer   User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  delivery   Delivery?
  review     Review?

  @@index([customerId])
  @@index([merchantId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  quantity  Int
  // Price snapshot taken at order time. NEVER recalculated from the current product price.
  priceAtOrder Decimal         @map("price_at_order") @db.Decimal(10, 2)
  status       OrderItemStatus @default(CONFIRMED)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Delivery {
  id           String         @id @default(uuid()) @db.Uuid
  orderId      String         @unique @map("order_id") @db.Uuid
  captainName  String         @map("captain_name") @db.VarChar(120)
  captainPhone String         @map("captain_phone") @db.VarChar(20)
  status       DeliveryStatus @default(ASSIGNED)
  deliveredAt  DateTime?      @map("delivered_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

model Review {
  id      String  @id @default(uuid()) @db.Uuid
  orderId String  @unique @map("order_id") @db.Uuid
  // Constrained to 1..5 by a CHECK constraint in the migration.
  rating  Int
  comment String? @db.VarChar(1000)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
