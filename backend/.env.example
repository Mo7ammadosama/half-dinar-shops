# Copy to .env and fill in real values. Never commit .env itself.
# Local dev matches the postgres service in /docker-compose.yml (host port 5433).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/halfdinar?schema=public"

NODE_ENV=development
PORT=3000

# Required. Must be 32+ random characters or the app refuses to start.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN=7d

# One-time passcode policy.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# DEVELOPMENT ONLY: returns the OTP in the API response so login is testable
# without an SMS provider. MUST be false (or unset) in production — the app
# refuses to boot if it is true while NODE_ENV=production.
EXPOSE_OTP_IN_RESPONSE=false

# --- SMS (login codes) ------------------------------------------------------
# Leave these unset for local development: the "console" sender prints the code
# instead of texting it. The app REFUSES TO BOOT in production without a real
# provider, so this cannot ship by accident.
#
# To go live, paste in the three Twilio values below and restart. Nothing else
# changes — the provider is auto-detected from these variables.
#
# ⏰ TWILIO_SMS_FROM must be an Alphanumeric Sender ID PRE-REGISTERED for Jordan
#    (~12 days approval). Zain and Orange BLOCK unregistered/generic senders, so
#    without it codes do not arrive at all. Full instructions: docs/SMS_SETUP.md
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=HalfDinar
#
# Alternative to TWILIO_SMS_FROM — a Twilio Messaging Service:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Force a provider ("console" or "twilio"). Auto-detected when unset.
# SMS_PROVIDER=
# SMS_TIMEOUT_MS=10000

# Product photo uploads.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# --- Product photo storage --------------------------------------------------
# Leave unset for local development: photos go to UPLOAD_DIR on local disk.
# The app REFUSES TO BOOT in production with local storage, because a redeploy
# silently destroys every photo the merchant uploaded.
#
# To go live, create a bucket and paste the values below, then restart. Nothing
# else changes — storage is auto-detected from these variables.
# Recommended: Cloudflare R2 (no egress fees). Full instructions:
# docs/STORAGE_SETUP.md
# S3_BUCKET=halfdinar-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
#
# S3-compatible endpoint (R2 / B2 / Spaces / MinIO). LEAVE UNSET for real AWS S3.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#
# S3_REGION=auto            # set a real region for AWS S3
# S3_KEY_PREFIX=products/
# STORAGE_PROVIDER=         # force "local" or "s3"; auto-detected when unset

# Flat delivery fee in JOD. Must have exactly 2 decimal places.
DELIVERY_FEE_JOD=0.50

# --- Rate limiting ----------------------------------------------------------
# Redis makes rate limits survive restarts and be shared across instances.
# REQUIRED IN PRODUCTION — the app refuses to boot without it, because
# in-memory limits reset on every redeploy and are per-instance, which makes
# the OTP/SMS abuse protection trivially bypassable (and every bypassed OTP
# costs real money). Local dev matches the redis service in /docker-compose.yml.
# See docs/REDIS_SETUP.md
REDIS_URL=redis://localhost:6380

# Requests per minute, per IP. The defaults shown are the production-safe values
# and apply when these are unset. Raise them only for automated UI test runs,
# where many registrations come from a single IP.
# RATE_LIMIT_DEFAULT_PER_MIN=100
# RATE_LIMIT_OTP_PER_MIN=3
# RATE_LIMIT_OTP_VERIFY_PER_MIN=10
# RATE_LIMIT_REGISTER_PER_MIN=5

# OTP requests per PHONE NUMBER per hour. Separate from the per-IP limits above:
# per-IP alone does not stop one number being targeted from many IPs.
# RATE_LIMIT_OTP_PER_PHONE_PER_HOUR=5

# --- Push notifications (customer's phone) ----------------------------------
# Default "console" logs instead of delivering: customers are NOT notified on a
# closed phone (launch blocker B6). Unlike SMS/storage there is no boot guard —
# the pilot works without push, it just means the customer must open the app.
#
# To go live: run `npx eas init` in mobile/ (writes a projectId into app.json —
# REQUIRED, no device can get a token without it), then set PUSH_PROVIDER=expo
# and restart. Full instructions: docs/PUSH_SETUP.md
# PUSH_PROVIDER=expo
# EXPO_ACCESS_TOKEN=          # only if Expo "enhanced security" is enabled
# PUSH_TIMEOUT_MS=10000

# --- AI product entry (photograph an item, skip the typing) -----------------
# Without a key the suggestions are CANNED demo data (the dashboard says so).
# The shop can always be stocked by hand, so there is no boot guard.
#
# To go live: create a key at console.anthropic.com and paste it below.
# ~$0.01-0.03 per photo, paid only when a merchant adds a product.
# Full instructions: docs/AI_VISION_SETUP.md
# ANTHROPIC_API_KEY=sk-ant-...
#
# Default claude-opus-4-8. Try claude-sonnet-5 to cut cost — product
# recognition is not a hard reasoning task.
# VISION_MODEL=claude-opus-4-8
# VISION_PROVIDER=          # force "mock" or "claude"; auto-detected from the key
# VISION_TIMEOUT_MS=30000

# --- Ignored-order escalation -----------------------------------------------
# How long a shop gets to acknowledge a new order before it is chased.
# Nudge the shop again after this long unconfirmed (default 120s):
# ESCALATION_FIRST_ALERT_SECONDS=120
# Alert the admin after this long unconfirmed (default 300s):
# ESCALATION_ADMIN_ALERT_SECONDS=300
