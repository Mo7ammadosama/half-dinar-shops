  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.36",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-image-picker": "~17.0.11",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "i18next": "^23.16.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^14.1.3",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.61.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "comments": {
    "expo": [
      "PINNED TO SDK 54 ON PURPOSE — do not upgrade without reading the root CLAUDE.md.",
      "Same reasoning as the customer app (mobile/): Expo Go on the App Store and Play",
      "Store is frozen at SDK 54, so SDK 54 is what the merchant's phone can install for",
      "free. See mobile/AGENTS.md and the root CLAUDE.md SDK section."
    ],
    "overrides": [
      "Mirrors mobile/: patches vulnerable dev-only transitive deps so npm audit stays at 0."
    ]
  },
  "overrides": {
    "uuid": "^11.1.1",
    "postcss": "^8.5.10"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:remote": "node scripts/start-remote.mjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --config jest.config.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
